{
  "manifest_version": 3,
  "name": "HabTrack Extension",
  "version": "2.0.2",
  "description": "Open HabTrack in a side panel and view public habit progress by username.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "HabTrack"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
